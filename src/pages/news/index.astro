---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';

// 完整消息列表按照發布日期由新到舊排列。
const posts = (await getCollection('news')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="最新消息｜北科資工系學會">
	<section class="mx-auto max-w-4xl pb-20 sm:pb-28" aria-labelledby="page-title">
		<header data-reveal class="border-b border-neutral-200 py-12 sm:py-16">
			<p lang="en" class="mb-5 font-mono text-xs tracking-[0.16em] text-neutral-400">NEWS</p>
			<div class="flex flex-wrap items-end justify-between gap-5">
				<div>
					<h1 id="page-title" class="text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">最新消息</h1>
					<p lang="en" class="mt-3 text-base text-neutral-400 sm:text-lg">News &amp; updates</p>
				</div>
				<p class="text-sm text-neutral-400">共 {posts.length} 則</p>
			</div>
		</header>

		<ul data-reveal>
			{posts.map((post) => <NewsRow post={post} />)}
		</ul>
		{posts.length === 0 && <p class="border-b border-neutral-200 py-10 text-sm text-neutral-500">目前沒有消息。</p>}
	</section>
</Layout>
