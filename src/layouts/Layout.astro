---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = '北科資工系學會',
	description = '北科資工第 25 屆系學會官方網站，提供最新公告與活動資訊。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<a href="/">北科資工系學會</a>
			<nav aria-label="主要導覽">
				<a href="/">首頁</a>
				<a href="/news/">最新公告</a>
				<a href="/#contact">聯絡我們</a>
			</nav>
		</header>
		<main><slot /></main>
		<footer>北科資工第 25 屆系學會</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
